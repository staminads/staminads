src/routeTree.gen.ts

# SDK files (copied from sdk/dist by copy-sdk.cjs) are committed so that every
# published version stays available — install snippets hard-pin the version in
# the URL (/sdk/staminads_<version>.min.js), so removing old files breaks sites
# that installed an earlier version. Do NOT re-ignore these.

